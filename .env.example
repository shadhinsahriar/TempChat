# TempChat Configuration
PROJECT_NAME="TempChat"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tempchat
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tempchat_test

# Security & CORS
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Room Settings
MIN_ROOM_DURATION_MINUTES=1
MAX_ROOM_DURATION_MINUTES=10080
DEFAULT_MAX_MEMBERS_GROUP=50
MAX_MEMBERS_GROUP_LIMIT=100

# WebSocket Settings
WS_TICKET_TTL_SECONDS=60
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_TYPING_TIMEOUT_SECONDS=5

# Storage Configuration
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="storage/media"

# S3 Configuration (when STORAGE_BACKEND="s3")
S3_BUCKET_NAME="tempchat-media"
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# Upload Limits (bytes)
MAX_IMAGE_SIZE_BYTES=10485760   # 10 MB
MAX_AUDIO_SIZE_BYTES=26214400   # 25 MB
MAX_FILE_SIZE_BYTES=52428800    # 50 MB

# Expiration Worker Settings
EXPIRATION_WORKER_INTERVAL_SECONDS=15
STORAGE_CLEANUP_INTERVAL_SECONDS=60
